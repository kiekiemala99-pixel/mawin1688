# คัดลอกค่าไปใส่ใน Render
# ห้ามอัปโหลดไฟล์ .env จริงขึ้น GitHub

NODE_ENV=production
VITE_AUTH_ENABLED=true
NODE_VERSION=22
NITRO_PRESET=node-server

# ใส่โดเมนจริงหลังได้ลิงก์ เช่น https://mawin1688.onrender.com
BETTER_AUTH_URL=https://YOUR-APP.onrender.com

# สร้างรหัสลับยาวอย่างน้อย 32 ตัว แล้ววางที่นี่
BETTER_AUTH_SECRET=change-me-to-64-random-chars

# Neon Postgres แบบ pooled + ssl
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# เบอร์โทรที่เป็นแอดมิน คั่นด้วยจุลภาค เฉพาะเบอร์นี้เห็นเมนูแอดมิน
STAFF_PHONES=0954515360
